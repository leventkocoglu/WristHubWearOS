<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:00"/>
    <Metadata key="STEP_GOAL" value="10000"/>

    <Scene backgroundColor="#000000">

        <!-- Time-driven dynamic background. All backgrounds disappear in ambient mode. -->
        <Condition>
            <Expressions>
                <Expression name="dawn"><![CDATA[[HOUR_0_23] >= 5 && [HOUR_0_23] < 8]]></Expression>
                <Expression name="day"><![CDATA[[HOUR_0_23] >= 8 && [HOUR_0_23] < 17]]></Expression>
                <Expression name="sunset"><![CDATA[[HOUR_0_23] >= 17 && [HOUR_0_23] < 20]]></Expression>
            </Expressions>

            <Compare expression="dawn">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Rectangle x="0" y="0" width="450" height="450">
                        <Fill color="#24152C">
                            <LinearGradient startX="0" startY="0" endX="0" endY="450"
                                colors="#1B183A #7A3E58 #E6A56A"
                                positions="0 0.58 1"/>
                        </Fill>
                    </Rectangle>
                </PartDraw>
                <PartDraw x="185" y="58" width="80" height="80">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Ellipse x="0" y="0" width="80" height="80">
                        <Fill color="#FFD58A"/>
                    </Ellipse>
                </PartDraw>
            </Compare>

            <Compare expression="day">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Rectangle x="0" y="0" width="450" height="450">
                        <Fill color="#0B2849">
                            <LinearGradient startX="0" startY="0" endX="0" endY="450"
                                colors="#07182A #0B345D #22546D"
                                positions="0 0.52 1"/>
                        </Fill>
                    </Rectangle>
                </PartDraw>
                <PartDraw x="190" y="48" width="70" height="70">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Ellipse x="0" y="0" width="70" height="70">
                        <Fill color="#F7D98B"/>
                    </Ellipse>
                </PartDraw>
            </Compare>

            <Compare expression="sunset">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Rectangle x="0" y="0" width="450" height="450">
                        <Fill color="#251B35">
                            <LinearGradient startX="0" startY="0" endX="0" endY="450"
                                colors="#21162E #5C2F48 #C66A58 #1C2236"
                                positions="0 0.40 0.70 1"/>
                        </Fill>
                    </Rectangle>
                </PartDraw>
                <PartDraw x="186" y="84" width="78" height="78">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Ellipse x="0" y="0" width="78" height="78">
                        <Fill color="#FFB06A"/>
                    </Ellipse>
                </PartDraw>
            </Compare>

            <Default>
                <PartDraw x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Rectangle x="0" y="0" width="450" height="450">
                        <Fill color="#02050B">
                            <LinearGradient startX="0" startY="0" endX="0" endY="450"
                                colors="#02040A #08111F #111827"
                                positions="0 0.65 1"/>
                        </Fill>
                    </Rectangle>
                </PartDraw>

                <!-- Moon -->
                <PartDraw x="322" y="78" width="62" height="62">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Ellipse x="0" y="0" width="62" height="62">
                        <Fill color="#F1DFC0"/>
                    </Ellipse>
                </PartDraw>

                <!-- Stars -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <Ellipse x="95" y="82" width="4" height="4"><Fill color="#D8E5FF"/></Ellipse>
                    <Ellipse x="144" y="118" width="3" height="3"><Fill color="#D8E5FF"/></Ellipse>
                    <Ellipse x="280" y="105" width="3" height="3"><Fill color="#D8E5FF"/></Ellipse>
                    <Ellipse x="350" y="168" width="4" height="4"><Fill color="#D8E5FF"/></Ellipse>
                    <Ellipse x="71" y="178" width="3" height="3"><Fill color="#D8E5FF"/></Ellipse>
                </PartDraw>
            </Default>
        </Condition>

        <!-- Subtle lower horizon, hidden in ambient. -->
        <PartDraw x="0" y="300" width="450" height="150">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Rectangle x="0" y="0" width="450" height="150">
                <Fill color="#18000000">
                    <LinearGradient startX="0" startY="0" endX="0" endY="150"
                        colors="#00000000 #8A000000"
                        positions="0 1"/>
                </Fill>
            </Rectangle>
        </PartDraw>

        <!-- Date -->
        <PartText x="55" y="112" width="340" height="42">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" color="#FFD38A">
                    <Template><![CDATA[%s %d %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Main time -->
        <DigitalClock x="35" y="150" width="380" height="120">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                x="0" y="0" width="380" height="120">
                <Font family="SYNC_TO_DEVICE" size="104" weight="BOLD" color="#FFFFFFFF"/>
            </TimeText>
        </DigitalClock>

        <!-- Battery -->
        <PartText x="55" y="286" width="105" height="70">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#6EE7A8">
                    <Template><![CDATA[%d%%]]><Parameter expression="[BATTERY_PERCENT]"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="55" y="338" width="105" height="32">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" color="#DDE6EF">PİL</Font>
            </Text>
        </PartText>

        <!-- Heart rate -->
        <PartText x="173" y="286" width="105" height="70">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FF7474">
                    <Template><![CDATA[%d]]><Parameter expression="round([HEART_RATE])"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="173" y="338" width="105" height="32">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" color="#DDE6EF">BPM</Font>
            </Text>
        </PartText>

        <!-- Steps -->
        <PartText x="290" y="286" width="105" height="70">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#65D8EF">
                    <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="290" y="338" width="105" height="32">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" color="#DDE6EF">ADIM</Font>
            </Text>
        </PartText>

        <!-- Ambient-only minimal date -->
        <PartText x="90" y="278" width="270" height="42" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="24" weight="NORMAL" color="#FFBFC7D5">
                    <Template><![CDATA[%d %s]]>
                        <Parameter expression="[DAY]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

    </Scene>
</WatchFace>
