<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>

  <Scene backgroundColor="#000000">

    <!-- Premium silver sunburst dial -->
    <PartImage x="0" y="0" width="450" height="450">
      <Image resource="dial"/>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
    </PartImage>

    <!-- Ambient black background -->
    <PartDraw x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255"/>
      <Ellipse x="8" y="8" width="434" height="434">
        <Fill color="#000000"/>
        <Stroke color="#505050" width="2"/>
      </Ellipse>
    </PartDraw>

    <!-- Date at 3 o'clock -->
    <PartText x="347" y="208" width="41" height="36">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#FF202020">
          <Template><![CDATA[%d]]><Parameter expression="[DAY]"/></Template>
        </Font>
      </Text>
    </PartText>

    <!-- Steps -->
    <PartText x="85" y="251" width="78" height="38">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FF252525">
          <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]"/></Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="91" y="279" width="66" height="20">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="10" color="#FF777777">ADIM</Font>
      </Text>
    </PartText>

    <!-- Heart rate -->
    <PartText x="287" y="251" width="78" height="38">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FF252525">
          <Template><![CDATA[%d]]><Parameter expression="round([HEART_RATE])"/></Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="293" y="279" width="66" height="20">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="10" color="#FF777777">BPM</Font>
      </Text>
    </PartText>

    <!-- Battery -->
    <PartText x="190" y="303" width="70" height="20">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="10" color="#FF767676">
          <Template><![CDATA[PİL %d%%]]><Parameter expression="[BATTERY_PERCENT]"/></Template>
        </Font>
      </Text>
    </PartText>

    <!-- Small digital time at 6 -->
    <DigitalClock x="172" y="340" width="106" height="38">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="106" height="38">
        <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" color="#FF202020"/>
      </TimeText>
    </DigitalClock>

    <!-- AOD digital time -->
    <DigitalClock x="125" y="304" width="200" height="76" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255"/>
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="200" height="76">
        <Font family="SYNC_TO_DEVICE" size="54" weight="THIN" color="#FFFFFFFF"/>
      </TimeText>
    </DigitalClock>

    <!-- Analog hands -->
    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="211" y="35" width="28" height="190" pivotX="0.5" pivotY="0.88"/>
      <MinuteHand resource="minute" x="214" y="5" width="22" height="220" pivotX="0.5" pivotY="0.90"/>
      <SecondHand resource="second" x="221" y="-5" width="8" height="245" pivotX="0.5" pivotY="0.857142857">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <Sweep frequency="15"/>
      </SecondHand>
    </AnalogClock>

    <!-- Center pin -->
    <PartDraw x="216" y="216" width="18" height="18">
      <Ellipse x="0" y="0" width="18" height="18"><Fill color="#FFAFAFB1"/></Ellipse>
      <Ellipse x="4" y="4" width="10" height="10"><Fill color="#FF4B4B4D"/></Ellipse>
      <Ellipse x="7" y="7" width="4" height="4"><Fill color="#FFE8E8E8"/></Ellipse>
    </PartDraw>

  </Scene>
</WatchFace>
